{
  "secrets": {
    "providers": {
      "default": {
        "source": "env"
      }
    }
  },
  "auth": {
    "profiles": {
      "zai:default": {
        "provider": "zai",
        "mode": "api_key"
      },
      "openai-codex:@@ADMIN_EMAIL@@": {
        "provider": "openai-codex",
        "mode": "oauth",
        "email": "@@ADMIN_EMAIL@@"
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "contextTokens": 180000,
      "compaction": {
        "mode": "safeguard",
        "maxHistoryShare": 0.2,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 4000
        }
      },
      "thinkingDefault": "high",
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 20,
        "maxChildrenPerAgent": 5,
        "maxSpawnDepth": 2
      },
      "model": "zai/glm-5.1",
      "imageModel": {
        "primary": "openai-codex/gpt-5.5",
        "fallbacks": ["openai-codex/gpt-5.4"]
      },
      "models": {
        "openai-codex/gpt-5.4": {},
        "openai-codex/gpt-5.5": {}
      }
    },
    "list": [
      {
        "id": "main",
        "name": "main",
        "workspace": "/home/node/.openclaw/workspace",
        "agentDir": "/home/node/.openclaw/agents/main/agent",
        "tools": {}
      }
    ]
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "telegram",
        "accountId": "main"
      }
    }
  ],
  "messages": {
    "ackReactionScope": "group-mentions",
    "groupChat": {
      "visibleReplies": "message_tool"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "cron": {
    "enabled": true
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "groupAllowFrom": ["@@TG_USER_ID@@"],
      "groups": {
        "*": {
          "requireMention": false
        }
      },
      "streaming": {
        "mode": "off"
      },
      "accounts": {
        "main": {
          "name": "main",
          "dmPolicy": "pairing",
          "botToken": {
            "source": "env",
            "provider": "default",
            "id": "TG_BOT_TOKEN"
          },
          "groupPolicy": "allowlist",
          "streaming": {
            "mode": "off"
          }
        },
        "default": {
          "dmPolicy": "pairing",
          "groupPolicy": "allowlist",
          "streaming": {
            "mode": "off"
          }
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": true
    },
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "remote": {
      "url": "ws://openclaw-gateway:18789",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "zai": {
        "enabled": true
      },
      "openai": {
        "enabled": true
      },
      "brave": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": {
              "source": "env",
              "provider": "default",
              "id": "BRAVE_SEARCH_TOKEN"
            },
            "mode": "web"
          }
        }
      },
      "browser": {
        "enabled": true
      }
    }
  },
  "browser": {
    "enabled": true,
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": true
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "zai": {
        "baseUrl": "https://api.z.ai/api/coding/paas/v4",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5.1",
            "name": "GLM-5.1",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 1.2, "output": 4, "cacheRead": 0.24, "cacheWrite": 0 },
            "contextWindow": 202800,
            "maxTokens": 131100
          },
          {
            "id": "glm-4.6",
            "name": "GLM-4.6",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 0.6, "output": 2.2, "cacheRead": 0.11, "cacheWrite": 0 },
            "contextWindow": 204800,
            "maxTokens": 131072
          }
        ]
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "brave",
        "maxResults": 15,
        "timeoutSeconds": 30
      }
    }
  }
}
