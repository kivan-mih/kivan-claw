{
  "version": 1,
  "profiles": {
    "zai:default": {
      "type": "api_key",
      "provider": "zai",
      "keyRef": {
        "source": "env",
        "provider": "default",
        "id": "ZAI_TOKEN"
      },
      "openai-codex:@@ADMIN_EMAIL@@": {
        "type": "oauth",
        "provider": "openai-codex",
        "access": "@@OAI_ACCESS_TOKEN@@",
        "refresh": "@@OAI_REFRESH_TOKEN@@",
        "expires": 3000000000000,
        "email": "@@ADMIN_EMAIL@@"
      }
    }
  }
}
