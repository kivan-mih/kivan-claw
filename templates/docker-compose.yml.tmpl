services:
  @@PREFIX@@-openclaw-gateway:
    image: ${OPENCLAW_IMAGE}
    build: .
    restart: unless-stopped
    env_file:
      - .env
    init: true
    runtime: sysbox-runc
    environment:
      HOME: /home/node
      TERM: xterm-256color
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: ${OPENCLAW_GATEWAY_TOKEN:-}
      OPENCLAW_ALLOW_INSECURE_PRIVATE_WS: ${OPENCLAW_ALLOW_INSECURE_PRIVATE_WS:-}
      TG_BOT_TOKEN: ${TG_BOT_TOKEN:-}
      ZAI_TOKEN: ${ZAI_TOKEN:-}
      BRAVE_SEARCH_TOKEN: ${BRAVE_SEARCH_TOKEN:-}
      USER_ACCEPT_PASSWORD: ${USER_ACCEPT_PASSWORD:-}
      USER_ACCEPT_WELCOME_TEXT: ${USER_ACCEPT_WELCOME_TEXT:-}
      HTTP_PROXY: ${HTTP_PROXY:-}
      HTTPS_PROXY: ${HTTP_PROXY:-}
      http_proxy: ${HTTP_PROXY:-}
      https_proxy: ${HTTP_PROXY:-}
      NO_PROXY: ${NO_PROXY:-localhost,127.0.0.1,::1}
      TZ: ${OPENCLAW_TZ:-UTC}
    volumes:
      - ${OPENCLAW_CONFIG_DIR}:/home/node/.openclaw
      - ${OPENCLAW_WORKSPACE_DIR}:/home/node/.openclaw/workspace
      - ${OPENCLAW_CONFIG_DIR}-templates:/opt/openclaw-templates:ro
      - ./.gitconfig:/home/node/.gitconfig:ro
    networks:
      - @@PREFIX@@-internal
    command:
      [
        "node",
        "--import",
        "./proxy_fix.ts",
        "dist/index.js",
        "gateway",
        "--bind",
        "${OPENCLAW_GATEWAY_BIND:-lan}",
        "--port",
        "18789",
      ]
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:18789/healthz').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

  @@PREFIX@@-openclaw-cli:
    image: ${OPENCLAW_IMAGE:-openclaw:local}
    env_file:
      - .env
    cap_drop:
      - NET_RAW
      - NET_ADMIN
    security_opt:
      - no-new-privileges:true
    environment:
      HOME: /home/node
      TERM: xterm-256color
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: ${OPENCLAW_GATEWAY_TOKEN:-}
      OPENCLAW_ALLOW_INSECURE_PRIVATE_WS: ${OPENCLAW_ALLOW_INSECURE_PRIVATE_WS:-}
      BROWSER: echo
      HTTP_PROXY: ${HTTP_PROXY:-}
      HTTPS_PROXY: ${HTTP_PROXY:-}
      http_proxy: ${HTTP_PROXY:-}
      https_proxy: ${HTTP_PROXY:-}
      NO_PROXY: ${NO_PROXY:-localhost,127.0.0.1,::1}
      TZ: ${OPENCLAW_TZ:-UTC}
    volumes:
      - ${OPENCLAW_CONFIG_DIR}:/home/node/.openclaw
      - ${OPENCLAW_WORKSPACE_DIR}:/home/node/.openclaw/workspace
      - ./.gitconfig:/home/node/.gitconfig:ro
    stdin_open: true
    tty: true
    init: true
    entrypoint: ["node", "--import", "./proxy_fix.ts", "dist/index.js"]
    depends_on:
      - @@PREFIX@@-openclaw-gateway
    networks:
      - @@PREFIX@@-internal

networks:
  @@PREFIX@@-internal:
    name: ${OPENCLAW_NETWORK}
    driver: bridge
    internal: true
  @@PREFIX@@-egress:
    name: @@EGRESS_NETWORK@@
    driver: bridge
