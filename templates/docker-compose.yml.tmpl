services:
  @@PREFIX@@-openclaw-gateway:
    image: @@PREFIX@@-openclaw:local
    build: .
    restart: unless-stopped
    env_file:
      - .env
    init: true
    runtime: sysbox-runc
    environment:
      HOME: /home/node
      TERM: xterm-256color
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: ${OPENCLAW_GATEWAY_TOKEN:-}
      OPENCLAW_ALLOW_INSECURE_PRIVATE_WS: ${OPENCLAW_ALLOW_INSECURE_PRIVATE_WS:-}
      TG_BOT_TOKEN: ${TG_BOT_TOKEN:-}
      ZAI_TOKEN: ${ZAI_TOKEN:-}
      BRAVE_SEARCH_TOKEN: ${BRAVE_SEARCH_TOKEN:-}
      USER_ACCEPT_PASSWORD: ${USER_ACCEPT_PASSWORD:-}
      USER_ACCEPT_WELCOME_TEXT: ${USER_ACCEPT_WELCOME_TEXT:-}
      HTTP_PROXY: http://@@PREFIX@@-proxy-guard:3128
      HTTPS_PROXY: http://@@PREFIX@@-proxy-guard:3128
      http_proxy: http://@@PREFIX@@-proxy-guard:3128
      https_proxy: http://@@PREFIX@@-proxy-guard:3128
      NO_PROXY: ${NO_PROXY:-localhost,127.0.0.1,::1}
      TZ: ${OPENCLAW_TZ:-UTC}
    volumes:
      - ${OPENCLAW_CONFIG_DIR}:/home/node/.openclaw
      - ${OPENCLAW_CONFIG_DIR}-templates:/opt/openclaw-templates:ro
      - ./.gitconfig:/home/node/.gitconfig:ro
    networks:
      - @@PREFIX@@-internal
    depends_on:
      @@PREFIX@@-proxy-guard:
        condition: service_started
    command:
      [
        "node",
        "--import",
        "./proxy_fix.ts",
        "dist/index.js",
        "gateway",
        "--bind",
        "${OPENCLAW_GATEWAY_BIND:-lan}",
        "--port",
        "18789",
      ]
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:18789/healthz').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

  @@PREFIX@@-openclaw-cli:
    image: @@PREFIX@@-openclaw:local
    env_file:
      - .env
    cap_drop:
      - NET_RAW
      - NET_ADMIN
    security_opt:
      - no-new-privileges:true
    environment:
      HOME: /home/node
      TERM: xterm-256color
      OPENCLAW_CONFIG_DIR: /home/node/.openclaw
      OPENCLAW_WORKSPACE_DIR: /home/node/.openclaw/workspace
      OPENCLAW_GATEWAY_TOKEN: ${OPENCLAW_GATEWAY_TOKEN:-}
      OPENCLAW_ALLOW_INSECURE_PRIVATE_WS: ${OPENCLAW_ALLOW_INSECURE_PRIVATE_WS:-}
      BROWSER: echo
      HTTP_PROXY: http://@@PREFIX@@-proxy-guard:3128
      HTTPS_PROXY: http://@@PREFIX@@-proxy-guard:3128
      http_proxy: http://@@PREFIX@@-proxy-guard:3128
      https_proxy: http://@@PREFIX@@-proxy-guard:3128
      NO_PROXY: ${NO_PROXY:-localhost,127.0.0.1,::1}
      TZ: ${OPENCLAW_TZ:-UTC}
    volumes:
      - ${OPENCLAW_CONFIG_DIR}:/home/node/.openclaw
      - ./.gitconfig:/home/node/.gitconfig:ro
    stdin_open: true
    tty: true
    init: true
    entrypoint: ["node", "--import", "./proxy_fix.ts", "dist/index.js"]
    depends_on:
      - @@PREFIX@@-openclaw-gateway
    networks:
      - @@PREFIX@@-internal

  @@PREFIX@@-proxy-guard:
    build: ./cp-openclaw-proxy
    container_name: @@PREFIX@@-proxy-guard
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - ./cp-openclaw-proxy/config:/app/config
    environment:
      TELEGRAM_BOT_TOKEN: ${TG_BOT_TOKEN:-}
      TELEGRAM_USER_ID: ${PROXY_TELEGRAM_USER_ID:-}
      VIRUSTOTAL_API_KEY: ${PROXY_VIRUSTOTAL_API_KEY:-}
      URLHAUS_AUTH_KEY: ${PROXY_URLHAUS_AUTH_KEY:-}
      WEB_RISK_API_KEY: ${PROXY_WEB_RISK_API_KEY:-}
      JAVA_OPTS: -Xms64m -Xmx256m
    networks:
      - @@PREFIX@@-internal
      - @@PREFIX@@-egress

  @@PREFIX@@-dashboard-forwarder:
    image: alpine/socat
    container_name: @@PREFIX@@-dashboard-forwarder
    restart: unless-stopped
    depends_on:
      - @@PREFIX@@-openclaw-gateway
    networks:
      - @@PREFIX@@-internal
      - @@PREFIX@@-ingress
    ports:
      - "127.0.0.1:${OPENCLAW_GATEWAY_PORT}:18789"
      - "127.0.0.1:${OPENCLAW_BRIDGE_PORT}:18790"
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        socat TCP-LISTEN:18789,fork,reuseaddr TCP:@@PREFIX@@-openclaw-gateway:18789 &
        socat TCP-LISTEN:18790,fork,reuseaddr TCP:@@PREFIX@@-openclaw-gateway:18790 &
        wait

networks:
  @@PREFIX@@-internal:
    name: @@PREFIX@@-internal
    driver: bridge
    internal: true
  @@PREFIX@@-egress:
    name: @@PREFIX@@-egress
    driver: bridge
  @@PREFIX@@-ingress:
    name: @@PREFIX@@-ingress
    driver: bridge
